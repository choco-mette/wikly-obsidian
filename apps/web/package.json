{
  "name": "@wikly/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "db:generate": "drizzle-kit generate --config=../../drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=../../drizzle.config.ts",
    "db:seed": "tsx --env-file=../../.env src/lib/db/seed.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@excalidraw/utils": "0.1.3-test32",
    "@wikly/api-contracts": "workspace:*",
    "@wikly/domain": "workspace:*",
    "@wikly/validation": "workspace:*",
    "d3-force": "^3.0.0",
    "drizzle-orm": "^0.44.0",
    "katex": "^0.18.6",
    "lucide-react": "^1.41.0",
    "marked": "^18.0.11",
    "mermaid": "^11.17.2",
    "next": "^16.1.0",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sanitize-html": "^2.17.7",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@types/d3-force": "^3.0.10",
    "@types/katex": "^0.16.8",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sanitize-html": "^2.16.1",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.1.0",
    "tsx": "^4.23.13"
  }
}
