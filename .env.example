# Compose services
POSTGRES_DB=wikly
POSTGRES_USER=wikly
POSTGRES_PASSWORD=change-me
# Host port only. PostgreSQL remains on 5432 inside Docker.
POSTGRES_PORT=5433
MINIO_ROOT_USER=wikly-minio
MINIO_ROOT_PASSWORD=change-me-use-at-least-8-characters

# Web application (used in a later phase)
DATABASE_URL=postgresql://wikly:change-me@localhost:5432/wikly
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./data/wiki-assets
# For S3-compatible storage:
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=wikly-assets
# S3_REGION=us-east-1
# S3_ACCESS_KEY=wikly-minio
# S3_SECRET_KEY=change-me-use-at-least-8-characters
